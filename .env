# Azure Cognitive Search Manager - Environment Configuration
# Copy this file to .env and modify the values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Azure Cognitive Search Manager
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
RELOAD=True

# =============================================================================
# FILE PATHS CONFIGURATION
# =============================================================================
CONFIG_DIR=azure_configs
INDEX_FILE_PATH=azure_configs/search_index.json
SKILLSET_FILE_PATH=azure_configs/search_skillset.json
BACKUP_DIR=azure_configs/backups

# =============================================================================
# AZURE COGNITIVE SEARCH SETTINGS
# =============================================================================
# Uncomment and configure these if you want to connect to actual Azure services
# AZURE_SEARCH_SERVICE_NAME=your-search-service
# AZURE_SEARCH_ADMIN_KEY=your-admin-key
# AZURE_SEARCH_QUERY_KEY=your-query-key
# AZURE_SEARCH_INDEX_NAME=your-index-name
# AZURE_SEARCH_SKILLSET_NAME=your-skillset-name

# =============================================================================
# DATABASE SETTINGS (if needed in future)
# =============================================================================
# DATABASE_URL=sqlite:///./azure_search.db
# DATABASE_ECHO=False

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/azure_search_manager.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
AUTO_CREATE_SAMPLE_FILES=True
BACKUP_BEFORE_OVERWRITE=True
ENABLE_API_DOCS=True
ENABLE_METRICS=True

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Set to True to enable development features
DEV_MODE=True
HOT_RELOAD=True
VERBOSE_LOGGING=True

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
TEST_CONFIG_DIR=test_configs
TEST_INDEX_FILE=test_configs/test_index.json
TEST_SKILLSET_FILE=test_configs/test_skillset.json